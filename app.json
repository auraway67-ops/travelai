{
  "expo": {
    "name": "AURA WAY",
    "slug": "aura-way",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#f5f5f0"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#d9f06a"
      },
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "AURA WAY uses your location to start trip routes from where you are."
        }
      ]
    ]
  }
}
